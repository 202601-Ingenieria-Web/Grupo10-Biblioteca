// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

// ─── CONFIGURACIÓN CORREGIDA PARA PRISMA 7+ ───────────────────
datasource db {
  provider = "postgresql"
  // Las URL de conexión se omiten aquí porque las inyecta prisma.config.ts
}

// ─── Enum de roles (ADMIN y USER) ─────────────────────────────
enum Role {
  ADMIN
  USER
}

// ─── Enum de tipo de movimiento ───────────────────────────────
enum MovementType {
  BORROW
  RETURN
  RESERVATION
}

// ─── Modelo de Usuario ────────────────────────────────────────
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  image     String?  // URL de foto/avatar (Requisito del PDF para el Sidebar)
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  // Relaciones
  booksCreated Book[]     @relation("CreadorMaestro")
  movements    Movement[] @relation("ResponsableMovimiento")
}

// ─── Modelo de Libro / Material ──────────────────────────────
model Book {
  id        String   @id @default(cuid())
  nombre    String
  saldo     Int      @default(0) // Saldo actual de inventario
  createdAt DateTime @default(now())

  // Relación con el usuario (ADMIN) que lo creó
  creadoPorId String
  creadoPor   User     @relation("CreadorMaestro", fields: [creadoPorId], references: [id])

  // Relaciones
  movements Movement[]
}

// ─── Modelo de Movimiento / Transacción ──────────────────────
model Movement {
  id        String       @id @default(cuid())
  fecha     DateTime     @default(now())
  tipo      MovementType // ENTRADA o SALIDA
  cantidad  Int          // Cantidad de elementos que salen o entran

  // Relación con el Libro al que pertenece
  bookId   String
  book     Book      @relation(fields: [bookId], references: [id])

  // Relación con el usuario en sesión responsable del movimiento
  responsableId String
  responsable   User     @relation("ResponsableMovimiento", fields: [responsableId], references: [id])
}

