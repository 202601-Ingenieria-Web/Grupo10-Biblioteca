// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

// ─── CONFIGURACIÓN CORREGIDA PARA PRISMA 7+ ───────────────────
datasource db {
  provider = "postgresql"
  // Las URL de conexión se omiten aquí porque las inyecta prisma.config.ts
}

// ─── Enum de roles (ADMIN y USER) ─────────────────────────────
enum Role {
  ADMIN
  USER
}

// ─── Enum de tipo de movimiento ───────────────────────────────
enum MovementType {
  ENTRADA
  SALIDA
}

// ─── Modelo de Usuario ────────────────────────────────────────
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  image     String?  // URL de foto/avatar (Requisito del PDF para el Sidebar)
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  // Relaciones
  maestrosCreados     Maestro[]    @relation("CreadorMaestro")
  movimientosEjecutados Movement[] @relation("ResponsableMovimiento")
}

// ─── Modelo de Maestro (Libro / Material) ────────────────────
model Maestro {
  id        String   @id @default(cuid())
  nombre    String
  saldo     Int      @default(0) // Saldo actual de inventario
  createdAt DateTime @default(now())

  // Relación con el usuario (ADMIN) que lo creó
  creadoPorId String
  creadoPor   User     @relation("CreadorMaestro", fields: [creadoPorId], references: [id])

  // Relaciones
  movimientos Movement[]
}

// ─── Modelo de Movimiento / Transacción ──────────────────────
model Movement {
  id        String       @id @default(cuid())
  fecha     DateTime     @default(now())
  tipo      MovementType // ENTRADA o SALIDA
  cantidad  Int          // Cantidad de elementos que salen o entran

  // Relación con el Maestro al que pertenece
  maestroId String
  maestro   Maestro      @relation(fields: [maestroId], references: [id])

  // Relación con el usuario en sesión responsable del movimiento
  responsableId String
  responsable   User     @relation("ResponsableMovimiento", fields: [responsableId], references: [id])
}